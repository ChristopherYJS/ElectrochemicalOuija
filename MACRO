IF DIO? 1=1;1xxx
    IF DIO? 2=1;11xx
        IF DIO? 3=1;111x
            IF DIO? 4=1;1111
                HLT
                CTO 1 2 1 1 3 2 1 7 1 

            ELSE;1110
                MVR 1 0.001
                CTO 1 2 1 1 3 2 1 7 1 

            ENDIF
        ELSE;110x
            IF DIO?4=1;1101
                MVR 1 0.002
                CTO 1 2 1 1 3 2 1 7 1 

            ELSE;1100
                MVR 1 0.005
                CTO 1 2 1 1 3 2 1 7 1 

            ENDIF
        ENDIF
    ELSE;10xx
        IF DIO? 3=1;101x
            IF DIO?4=1;1011
                MVR 1 0.010
                CTO 1 2 1 1 3 2 1 7 1 

            ELSE;1010
                MVR 2 0.001
                CTO 1 2 2 1 3 2 1 7 1 

            ENDIF
        ELSE;100x
            IF DIO?4=1;1001
                MVR 2 0.002
                CTO 1 2 2 1 3 2 1 7 1 

            ELSE;1000
                MVR 2 0.005
                CTO 1 2 2 1 3 2 1 7 1 

            ENDIF
        ENDIF
    ENDIF
ELSE ;0xxx
    IF DIO? 2=1;01xx
        IF DIO? 3=1;011x
            IF DIO?4=1;0111
                MVR 2 0.010
                CTO 1 2 2 1 3 2 1 7 1 

            ELSE;0110
                MVR 3 0.001
                CTO 1 2 3 1 3 2 1 7 1 

            ENDIF
        ELSE;010x
            IF DIO?4=1;0101
                MVR 3 0.002
                CTO 1 2 3 1 3 2 1 7 1 

            ELSE;0100
                MVR 3 0.005
                CTO 1 2 3 1 3 2 1 7 1 

            ENDIF
        ENDIF
    ELSE;00xx
        IF DIO? 3=1;001x
            IF DIO?4=1;0011
                MVR 3 0.010
                CTO 1 2 3 1 3 2 1 7 1 

            ELSE;0010
                MVR 1 -0.001
                CTO 1 2 1 1 3 2 1 7 1 

            ENDIF
        ELSE;000x
            IF DIO?4=1;0001
                MVR 1 -0.005
                CTO 1 2 1 1 3 2 1 7 1 

            ELSE;0000
                MVR 1 -0.010
                CTO 1 2 1 1 3 2 1 7 1 

            ENDIF
        ENDIF
    ENDIF
ENDIF